"raw_rules": [
{
"_comment": "Evaluated on the RAW feed text BEFORE score targets are stripped. A -1000 (loser-wins) target such as '1000/100' or '-1000' in a 1-player-per-team game => LOSER WINS. Other targets (300/50, 400/100, 500/50) are ignored.",
"label": "LOSER WINS",
"match": "LOS\\w*R? ?WIN|(?<![\\d/])-?1000(?!\\d)",
"perteam": 1
}
],
"rules": [
{
"_comment": "Score-only / bare Spades with 2 per team => REG PARTNERS (e.g. feed '500/100').",
"label": "REG PARTNERS",
"match": "^(SPADES)?$",
"perteam": 2
},
{
"_comment": "User 2026-10-10: bare Spades / score-only target with 1 per team => CUT (e.g. '400/100'). Not for 2-player partners.",
"label": "CUT",
"match": "^(SPADES)?$",
"perteam": 1
},
{
"_comment": "Also catches the feed typo \"Loser Wim\" (2026-10-08).",
"label": "LOSER WINS",
"match": "LOS[E]?R ?WI[NM]S?"
},
{
"label": "CUT MIRRORS",
"match": "MIRROR"
},
{
"_comment": "User 2026-10-08: any 1 vs 1 vs 1 (three-way / cutthroat) tour is always labeled CUT.",
"label": "CUT",
"match": "\\b1 ?(VS?\\.?|V|X) ?1 ?(VS?\\.?|V|X) ?1\\b|\\b3 ?-?WAY\\b|CUT ?THROAT",
"not": "MIRROR"
},
{
"_comment": "Bare 1 vs 1 (e.g. CHOICE SINGLES) with 1 per team => SINGLES. Three-way 1 vs 1 vs 1 is handled above as CUT.",
"label": "SINGLES",
"match": "^1 ?(VS?\\.?|V|X) ?1$",
"perteam": 1
},
{
"label": "REG SPADES PAB",
"match": "PARD ?A ?BOT|PARTNER ?A ?BOT|\\bPAB\\b",
"not": "SUI"
},
{
"label": "SUI PASS 2 PAB",
"match": "PARD ?A ?BOT|PARTNER ?A ?BOT|\\bPAB\\b",
"match2": "SUI"
},
{
"_comment": "User 2026-10-08: SUI + Random Partners",
"label": "SUI PASS 2 RANDOM",
"match": "SUI.*RANDOM|RANDOM.*SUI(?:CIDE)?"
},
{
"_comment": " User 2026-10-08: always show as SUICIDE PASS 2 (was SUI PASS 2 PARTNERS).",
"label": "SUI PASS 2",
"match": "SUI",
"perteam": 2
},
{
"label": "CUT",
"match": "\\bCUT\\b",
"perteam": 1
},
{
"_comment": "User 2026-10-10: SINGLES tours are always labeled just SINGLES (no 300/50 score suffix; norm_feed strips targets).",
"label": "SINGLES",
"match": "SINGLES",
"not": "SUI",
"perteam": 1
},
{
