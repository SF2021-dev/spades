<!doctype html>
<html lang="en"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Diamond Spaders - Group Chat</title>
<link rel="icon" href="/diamondspaderslogo.jpg">
<style>
@font-face{font-family:'DS Coustard';src:url(/fonts/coustard-400-latin.woff2) format('woff2')}
html,body{margin:0;background:#0a0a0a;color:#f3bf56;font-family:'DS Coustard','Clarendon','Century Schoolbook',Georgia,serif}
.card{max-width:900px;margin:16px auto;background:#000;border:1px solid #f3bf56;border-radius:10px;padding:10px 12px;box-sizing:border-box}
.title{display:flex;justify-content:space-between;align-items:baseline;font-size:18px;font-weight:700;margin-bottom:8px}
.title a{color:#f3bf56;text-decoration:none}.title a:hover{text-decoration:underline}
.msgs{background:#f3bf56;border:1px solid #cb972e;border-radius:8px;padding:10px 12px;min-height:calc(100dvh - 260px);max-height:calc(100dvh - 220px);overflow:auto;margin-bottom:12px}
.msgs:empty::before{content:'Messages will show here';color:#666;font-size:14px}
.line{font-size:20px;color:#000;line-height:1.18;padding:3px 0;border-bottom:1px solid #cb972e;overflow-wrap:anywhere;-webkit-text-stroke:.9px currentColor}
.line:last-child{border-bottom:0}.line b{color:#4a2a00}.line small{font-size:12px;color:#5c4210;-webkit-text-stroke:0}
.line audio{vertical-align:middle;height:32px;max-width:100%}
.compose{display:flex;gap:8px;align-items:center;position:relative}
.compose .who{white-space:nowrap;font-weight:700}
textarea,input{flex:1;font:inherit;font-size:18px;background:#f3bf56;color:#000;border:1px solid #cb972e;border-radius:8px;padding:8px;resize:none;box-sizing:border-box}
button{font:inherit;background:#161616;color:#fbe646;border:1px solid #f3bf56;border-radius:8px;padding:7px 12px;cursor:pointer}
button:hover{background:#2a1608}
.spk{font-size:24px;padding:4px 10px;line-height:1}
.menu{position:absolute;bottom:52px;right:0;background:#000;border:1px solid #f3bf56;border-radius:10px;padding:8px;display:flex;flex-direction:column;gap:6px;z-index:5}
.panel{border:1px solid #f3bf56;border-radius:8px;padding:10px;margin-top:10px;display:flex;flex-wrap:wrap;gap:8px;align-items:center}
.note{color:#fbe646;font-size:15px;margin:8px 0}
.hide{display:none!important}
.live{color:#ff5c5c;font-weight:700}
#pending .req{display:flex;gap:8px;align-items:center;margin:6px 0;flex-wrap:wrap}
</style></head><body>
<div class="card">
  <div class="title"><span>Diamond Spaders Group Chat</span><span id="withLbl"></span><a href="/">Diamond Spaders Online &raquo;</a></div>

  <!-- step 1: log in (same name + 3-digit PIN as the message board) -->
  <div id="login" class="hide">
    <p class="note">Log in with your message-board name and 3-digit PIN.</p>
    <div class="compose"><input id="lname" placeholder="your username" maxlength="40"><input id="lpin" placeholder="PIN" maxlength="3" inputmode="numeric" type="password" style="flex:0 0 90px"><button id="lgo">Log in</button></div>
    <p class="note" id="lerr"></p>
  </div>

  <!-- chat requests waiting for me (shown at login) -->
  <div id="pending" class="hide panel" style="flex-direction:column;align-items:flex-start"></div>

  <!-- step 2: recipients -->
  <div id="pick" class="hide">
    <div id="mygroups"></div>
    <p class="note">Start a new group chat: add each player's username (Enter adds), then press Start.</p>
    <div class="compose"><input id="rname" placeholder="recipient's username" maxlength="40"><button id="radd">Add</button><button id="rgo">Start group chat</button></div>
    <div id="chips" class="note"></div>
    <div id="notfound" class="hide panel">
      <span id="nfmsg"></span>
      <button id="nfretry">Fix the names and try again</button>
      <button onclick="location.href='/'">Return to Diamond Spaders Online</button>
    </div>
    <p class="note" id="perr"></p>
  </div>

  <!-- step 3: chat -->
  <div id="chat" class="hide">
    <div class="msgs" id="msgs"></div>
    <p class="note hide" id="waitmsg"></p>
    <div class="compose" id="composer">
      <span class="who" id="me"></span>
      <textarea id="txt" rows="1" placeholder="type here (enter to send)"></textarea>
      <button class="spk" id="spk" title="Voice">&#128264;</button>
      <div class="menu hide" id="menu">
        <button data-v="mic">&#127908; Microphone (live)</button>
        <button data-v="rec">&#9210; Record a clip</button>
        <button data-v="tts">&#128483; Text to speech</button>
      </div>
    </div>
    <div class="panel hide" id="pMic"><span id="micState">Live mic is off.</span><button id="micGo">Start talking</button><button id="micStop" class="hide">Stop</button><button class="close">Close</button>
      <label style="font-size:14px"><input type="checkbox" id="hear" checked style="flex:none"> play their live audio</label></div>
    <div class="panel hide" id="pRec"><span id="recState">Ready to record.</span>
      <button id="recGo">&#9210; Record</button><button id="recStop" class="hide">&#9209; Stop</button>
      <span id="recDone" class="hide"><button id="recReview">&#9654; Review</button> <button id="recSend">Send</button> <button id="recAgain">Start over</button></span>
      <button class="close">Close</button><audio id="recAudio" class="hide"></audio></div>
    <div class="panel hide" id="pTts"><input id="ttsTxt" placeholder="type, then press Enter - it will be spoken to them" maxlength="1000"><button class="close">Close</button></div>
    <p class="note" style="font-size:13px"><a href="/group-chat" style="color:#f3bf56">My group chats / start another</a> &middot; <a href="/chat" style="color:#f3bf56">Private chat</a></p>
  </div>
</div>
<script>
(function(){
var $ = function(i){ return document.getElementById(i); }, show = function(el, on){ el.classList.toggle("hide", !on); };
var ME = "", WITH = "", since = 0, seen = {}, poll = null;
function api(q, body){
  return fetch("/api/groupchat" + (body ? "" : "?" + q), body ? {method:"POST", headers:{"Content-Type":"application/json"}, body:JSON.stringify(body), credentials:"same-origin"} : {credentials:"same-origin", cache:"no-store"})
    .then(function(r){ return r.json().catch(function(){ return {}; }).then(function(j){ if (!r.ok) { var e = new Error(j.error || ("Error " + r.status)); e.status = r.status; throw e; } return j; }); });
}
function esc(s){ return String(s).replace(/[&<>"']/g, function(c){ return {"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]; }); }
function speak(t){ try { var u = new SpeechSynthesisUtterance(t); speechSynthesis.speak(u); } catch(e){} }

// ---- login ----
function start(){
  api("action=me").then(function(j){ ME = j.name; afterLogin(); }).catch(function(){ show($("login"), true); $("lname").value = localStorage.getItem("ds-mb-name") || ""; });
}
$("lgo").onclick = function(){
  var n = $("lname").value.trim(), p = $("lpin").value.trim(); $("lerr").textContent = "";
  fetch("/api/pin", {method:"POST", headers:{"Content-Type":"application/json"}, credentials:"same-origin", body:JSON.stringify({name:n, pin:p, action:"check", remember:true})})
    .then(function(r){ return r.json().then(function(j){ if (!r.ok) throw new Error(j.error || "Login failed"); }); })
    .then(function(){ show($("login"), false); start(); })
    .catch(function(e){ $("lerr").textContent = e.message + (/PIN for this name/.test(e.message) ? " (create one on the main page message board first)" : ""); });
};
$("lpin").onkeydown = function(e){ if (e.key === "Enter") $("lgo").click(); };

// ---- group invites waiting for me ("on next login") ----
function who(ms){ return ms.map(function(m){ return esc(m.name) + (m.status === "pending" ? " (invited)" : ""); }).join(", "); }
function loadPending(){
  return api("action=pending").then(function(j){
    var b = $("pending"); b.innerHTML = ""; show(b, j.invites.length > 0);
    if (j.invites.length) b.insertAdjacentHTML("beforeend", "<b>Group chat invitations</b>");
    j.invites.forEach(function(r){
      var d = document.createElement("div"); d.className = "req";
      d.innerHTML = "<span><b>" + esc(r.owner) + "</b> invited you to a group chat with " + who(r.members) + ".</span>";
      [["Join", true], ["Decline", false]].forEach(function(o){
        var bt = document.createElement("button"); bt.textContent = o[0];
        bt.onclick = function(){ api(null, {action:"answer", gid:r.gid, ok:o[1]}).then(function(){
          if (o[1]) location.href = "/group-chat?g=" + r.gid; else { loadPending(); loadMine(); } }); };
        d.appendChild(bt);
      });
      b.appendChild(d);
    });
  }).catch(function(){});
}
function loadMine(){
  api("action=mine").then(function(j){
    var b = $("mygroups"); b.innerHTML = "";
    var ok = j.groups.filter(function(g){ return g.myStatus === "ok"; });
    if (ok.length) b.insertAdjacentHTML("beforeend", "<p class=note>Your group chats:</p>");
    ok.forEach(function(g){ var d = document.createElement("div"); d.className = "req";
      d.innerHTML = "<button>Open</button> <span>" + who(g.members) + "</span>"; d.querySelector("button").onclick = function(){ openGroup(g.gid); }; b.appendChild(d); });
  }).catch(function(){});
}
function afterLogin(){
  $("me").textContent = ME + ":";
  loadPending();
  var g = new URLSearchParams(location.search).get("g");
  if (g) openGroup(g); else { show($("pick"), true); loadMine(); $("rname").focus(); }
}

// ---- recipients ----
var NAMES = [];
function chips(){ $("chips").innerHTML = NAMES.map(function(n, i){ return "<button data-i=" + i + ">" + esc(n) + " &times;</button>"; }).join(" ");
  Array.prototype.forEach.call($("chips").querySelectorAll("button"), function(b){ b.onclick = function(){ NAMES.splice(+b.dataset.i, 1); chips(); }; }); }
function addName(){ String($("rname").value).split(",").forEach(function(n){ n = n.trim();
  if (n && NAMES.map(function(x){ return x.toLowerCase(); }).indexOf(n.toLowerCase()) < 0) NAMES.push(n); }); $("rname").value = ""; chips(); }
$("radd").onclick = addName;
$("rname").onkeydown = function(e){ if (e.key === "Enter") { e.preventDefault(); addName(); } };
$("rgo").onclick = function(){
  addName(); $("perr").textContent = ""; show($("notfound"), false);
  if (!NAMES.length) { $("perr").textContent = "Add at least one username."; return; }
  api("action=check&names=" + encodeURIComponent(NAMES.join(","))).then(function(j){
    if (j.missing.length) { $("nfmsg").textContent = "Not on the Diamond Spaders player list: " + j.missing.join(", ") + "."; show($("notfound"), true);
      NAMES = j.found.concat(j.missing); chips(); return; }
    return api(null, {action:"create", names:j.found}).then(function(r){ openGroup(r.gid); });
  }).catch(function(e){ $("perr").textContent = e.message; });
};
$("nfretry").onclick = function(){ show($("notfound"), false); $("rname").focus(); };

// ---- chat ----
var GID = "";
function openGroup(gid){
  GID = gid; WITH = "the group"; show($("pick"), false); show($("chat"), true);
  history.replaceState(null, "", "/group-chat?g=" + encodeURIComponent(gid));
  tick(); poll = setInterval(tick, 2000);
}
function tick(){
  api("action=list&gid=" + encodeURIComponent(GID) + "&since=" + since).then(function(j){
    show($("composer"), true); show($("waitmsg"), false);
    $("withLbl").textContent = "with " + j.members.filter(function(m){ return m.name.toLowerCase() !== ME.toLowerCase(); }).map(function(m){ return m.name + (m.status === "pending" ? " (invited)" : m.status === "no" ? " (declined)" : ""); }).join(", ");
    j.messages.forEach(render);
  }).catch(function(e){ show($("composer"), false); show($("waitmsg"), true); $("waitmsg").textContent = e.message; });
}
var liveQ = [], livePlaying = false;
function playLive(){
  if (livePlaying || !liveQ.length) return; livePlaying = true;
  var a = new Audio(liveQ.shift()); a.onended = a.onerror = function(){ livePlaying = false; playLive(); }; a.play().catch(function(){ livePlaying = false; });
}
function render(m){
  if (seen[m.id]) return; seen[m.id] = 1; since = Math.max(since, m.t);
  var mine = m.from.toLowerCase() === ME.toLowerCase(), src = "/api/chat/audio/" + encodeURIComponent(m.id);
  var fresh = Date.now() - m.t < 60000;
  if (m.kind === "live") {   // live mic segments: played as they arrive, not listed
    if (!mine && fresh && $("hear").checked) { liveQ.push(src); playLive(); }
    return;
  }
  var d = document.createElement("div"); d.className = "line";
  var who = "<b>" + esc(m.from) + ":</b> ", when = " <small>" + new Date(m.t).toLocaleTimeString([], {hour:"numeric", minute:"2-digit"}) + "</small>";
  if (m.kind === "clip") d.innerHTML = who + "<audio controls preload=none src='" + src + "'></audio>" + when;
  else if (m.kind === "tts") {
    d.innerHTML = who + "&#128483; " + esc(m.body) + " <button class=say>&#128264;</button>" + when;
    d.querySelector(".say").onclick = function(){ speak(m.body); };
    if (!mine && fresh) speak(m.body);
  } else d.innerHTML = who + esc(m.body) + when;
  var box = $("msgs"), atEnd = box.scrollHeight - box.scrollTop - box.clientHeight < 40;
  box.appendChild(d); if (atEnd || mine) box.scrollTop = box.scrollHeight;
}
function sendText(kind, t, after){
  t = t.trim(); if (!t) return;
  api(null, {action:"send", gid:GID, kind:kind, body:t}).then(function(){ after(); tick(); }).catch(function(e){ alert(e.message); });
}
$("txt").onkeydown = function(e){ if (e.key === "Enter" && !e.shiftKey) { e.preventDefault(); sendText("text", $("txt").value, function(){ $("txt").value = ""; }); } };

// ---- voice menu ----
$("spk").onclick = function(e){ e.stopPropagation(); $("menu").classList.toggle("hide"); };
document.addEventListener("click", function(){ show($("menu"), false); });
Array.prototype.forEach.call(document.querySelectorAll("#menu button"), function(b){
  b.onclick = function(){ show($("menu"), false); ["pMic","pRec","pTts"].forEach(function(p){ show($(p), false); });
    show($({mic:"pMic", rec:"pRec", tts:"pTts"}[b.dataset.v]), true); if (b.dataset.v === "tts") $("ttsTxt").focus(); };
});
Array.prototype.forEach.call(document.querySelectorAll(".panel .close"), function(b){ b.onclick = function(){ show(b.parentNode, false); stopMic(); }; });
$("ttsTxt").onkeydown = function(e){ if (e.key === "Enter") { e.preventDefault(); var t = $("ttsTxt").value; speak(t); sendText("tts", t, function(){ $("ttsTxt").value = ""; }); } };

function toData(blob){ return new Promise(function(res){ var r = new FileReader(); r.onload = function(){ res(r.result); }; r.readAsDataURL(blob); }); }
function sendAudio(blob, kind){ return toData(blob).then(function(d){ return api(null, {action:"audio", gid:GID, kind:kind, audio:d}); }); }
function getMic(){ return navigator.mediaDevices.getUserMedia({audio:true}); }

// Record: record -> stop -> review / send / start over
var rec = null, recBlob = null, recStream = null;
$("recGo").onclick = function(){
  getMic().then(function(s){
    recStream = s; var parts = []; rec = new MediaRecorder(s);
    rec.ondataavailable = function(e){ if (e.data.size) parts.push(e.data); };
    rec.onstop = function(){ s.getTracks().forEach(function(t){ t.stop(); }); recBlob = new Blob(parts, {type: rec.mimeType || "audio/webm"});
      $("recAudio").src = URL.createObjectURL(recBlob); $("recState").textContent = "Recorded " + Math.round(recBlob.size / 1024) + " KB.";
      show($("recStop"), false); show($("recDone"), true); };
    rec.start(); $("recState").innerHTML = "<span class=live>&#9679; Recording...</span>"; show($("recGo"), false); show($("recStop"), true); show($("recDone"), false);
    setTimeout(function(){ if (rec && rec.state === "recording") rec.stop(); }, 120000);   // 2 min cap
  }).catch(function(){ $("recState").textContent = "Microphone not available (allow mic access)."; });
};
$("recStop").onclick = function(){ if (rec && rec.state === "recording") rec.stop(); };
$("recReview").onclick = function(){ $("recAudio").currentTime = 0; $("recAudio").play(); };
$("recAgain").onclick = function(){ recBlob = null; show($("recDone"), false); show($("recGo"), true); $("recState").textContent = "Ready to record."; };
$("recSend").onclick = function(){ if (!recBlob) return; $("recState").textContent = "Sending...";
  sendAudio(recBlob, "clip").then(function(){ $("recAgain").click(); $("recState").textContent = "Sent!"; tick(); }).catch(function(e){ $("recState").textContent = e.message; }); };

// Microphone (live): short self-contained segments sent every ~2s, played in order on their side
var micStream = null, micOn = false;
function segment(){
  if (!micOn) return;
  var parts = [], r = new MediaRecorder(micStream);
  r.ondataavailable = function(e){ if (e.data.size) parts.push(e.data); };
  r.onstop = function(){ if (parts.length) sendAudio(new Blob(parts, {type: r.mimeType || "audio/webm"}), "live").catch(function(e){ $("micState").textContent = e.message; }); segment(); };
  r.start(); setTimeout(function(){ if (r.state === "recording") r.stop(); }, 2000);
}
$("micGo").onclick = function(){
  getMic().then(function(s){ micStream = s; micOn = true; segment();
    $("micState").innerHTML = "<span class=live>&#9679; LIVE - " + "the group hears you (about 2-4 s delay)</span>"; show($("micGo"), false); show($("micStop"), true);
  }).catch(function(){ $("micState").textContent = "Microphone not available (allow mic access)."; });
};
function stopMic(){ micOn = false; if (micStream) micStream.getTracks().forEach(function(t){ t.stop(); }); micStream = null;
  $("micState").textContent = "Live mic is off."; show($("micGo"), true); show($("micStop"), false); }
$("micStop").onclick = stopMic;

start();
})();
</script>
</body></html>
